# Copie este arquivo para ".env" e preencha. O .env nunca vai para o Git.
# Neo4j Aura: o arquivo de credenciais que o Aura baixa (Neo4j-xxxx-Created-AAAA-MM-DD.txt)
# ja vem neste formato: basta copiar as linhas NEO4J_* para o .env.
NEO4J_URI=neo4j+s://SEU_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sua_senha_aqui
NEO4J_DATABASE=neo4j

# Gemini: crie uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui
# Opcional: fixa o modelo de texto (se vazio, o projeto escolhe o Flash-Lite estavel mais novo)
GEMINI_MODEL=gemini-3.5-flash-lite
