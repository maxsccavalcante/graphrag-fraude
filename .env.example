# Copie este arquivo para ".env" e preencha com os dados da sua instancia Neo4j Aura.
# O arquivo de credenciais que o Aura baixa (Neo4j-xxxx-Created-AAAA-MM-DD.txt)
# ja vem neste formato: basta copiar as linhas NEO4J_* para o .env.
NEO4J_URI=neo4j+s://SEU_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sua_senha_aqui
NEO4J_DATABASE=neo4j
